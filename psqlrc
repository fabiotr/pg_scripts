--SET transaction_timeout = '60min';
--SET statement_timeout = '60s';

\if :svp_pg_92
  SELECT pg_is_in_recovery() AS is_reader 
  \gset svp_
  \if :svp_is_reader
    \set PROMPT1 '%[%033[1;4;33m%]%m%[%033[1;24;38;5;105m%] R%[%033[0m%] %[%033[1;3;96m%]%n@%/%[%033[0m%]%R%# '
  \else
    \set PROMPT1 '%[%033[1;4;31m%]%m%[%033[1;24;38;5;216m%] W%[%033[0m%] %[%033[1;3;96m%]%n@%/%[%033[0m%]%R%# '
  \endif
\endif
\x auto
\timing on
\set QUIET OFF
